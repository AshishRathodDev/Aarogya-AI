FROM python:3.11-slim

WORKDIR /app

# Copy and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/aarogya_ai ./aarogya_ai
COPY params.yaml .
COPY crack-decorator-468911-s1-5ab46e3aea4b.json .

# Set PYTHONPATH for proper imports
ENV PYTHONPATH=/app

# Expose port (Cloud Run will override with PORT env var)
EXPOSE 8080

# Use JSON format for CMD to prevent signal handling issues
CMD ["sh", "-c", "exec gunicorn -w 2 -k uvicorn.workers.UvicornWorker aarogya_ai.api.main:app --bind 0.0.0.0:${PORT:-8080} --timeout 0 --preload"]
