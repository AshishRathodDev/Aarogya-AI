# .dockerignore

# Ignore Python virtual environment
.venv/

# Ignore IDE and editor specific files
.vscode/
.idea/

# Ignore Python cache files
__pycache__/
*.pyc

# Ignore test files and reports for production image
tests/
.pytest_cache/

# CRITICAL: Ignore large data and notebooks folders
data/
notebooks/

# Ignore Git files
.git/
.gitignore

# Ignore local environment files
.env

# --- [CRITICAL FIX] ---
# Ignore all other JSON files...
*.json
# ...BUT explicitly DO NOT ignore our credentials file!
!crack-decorator-468911-s1-5ab46e3aea4b.json



